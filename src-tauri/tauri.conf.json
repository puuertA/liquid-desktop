{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Liquid Desktop",
  "version": "0.3.0",
  "identifier": "dev.liquiddesktop.app",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "label": "main", "visible": false, "title": "Liquid Desktop · Widgets", "width": 940, "height": 820, "minWidth": 760, "minHeight": 660 }], "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost" } },
  "bundle": { "active": true, "targets": ["nsis"], "shortDescription": "Liquid Desktop — prova de conceito", "windows": { "nsis": { "installMode": "currentUser" } } }
}
